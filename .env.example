# ---- Local infra (docker compose) ----
# Owner connection: used by the aggregator (writes) and the simulator (tenant registry).
DATABASE_URL=postgres://nymbus:nymbus@localhost:5432/nymbus
# Read-only, row-level-security-enforced connection used by the dashboard API.
API_DATABASE_URL=postgres://dashboard_api:dashboard_api@localhost:5432/nymbus
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=txn-metrics
KAFKA_TOPIC_PARTITIONS=6
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- Services ----
API_PORT=4000
SIM_CONTROL_PORT=4100
SIM_CONTROL_URL=http://localhost:4100
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Simulator sizing (defaults match the brief: ~50 tenants, 5 vendors, 100-150 tps) ----
SIM_TENANTS=50
SIM_TPS_SCALE=1

# ---- Aggregator tuning ----
AGG_FLUSH_MS=1000
AGG_GROUP_ID=txn-metrics-aggregator

# Optional tuning (defaults shown)
# AGG_PAUSE_THRESHOLD=50000      # aggregator pauses Kafka fetch when this many raw events await a flush
# AGG_INSTANCE_ID=<hostname>-<pid> # aggregator identity in heartbeats and OTel resource attributes
# BACKFILL_HOURS=24               # how much synthetic history `npm run db:backfill` writes
